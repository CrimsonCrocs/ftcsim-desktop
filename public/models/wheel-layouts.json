{
  "purpose": "Reference transforms for the converted source CAD assets. Position expressions are symbolic and must be resolved using the selected chassis dimensions.",
  "coordinateSystem": {
    "world": "+X is forward, +Y is up, +Z is robot-left.",
    "position": "[x, y, z] in metres",
    "rotation": "[x, y, z] Euler radians, applied with Three.js rotation.set(x, y, z, 'XYZ').",
    "symbols": {
      "wheelbase": "longitudinal distance between front and rear wheel axle centres",
      "trackwidth": "lateral distance between left and right wheel axle centres",
      "wheelRadius": "the radius on the selected asset entry"
    }
  },
  "assets": {
    "revOmni90": {
      "file": "/models/rev-41-1190-90mm-omni.glb",
      "radius": 0.0447,
      "width": 0.015,
      "sourceHubAxis": [0, 0, 1],
      "notes": "The source CAD is already upright for this coordinate system: its axle is local +Z."
    },
    "goBildaLeftMecanum104": {
      "file": "/models/gobilda-3625-0100-0104-left-mecanum.glb",
      "sku": "3625-0100-0104",
      "radius": 0.05199,
      "width": 0.03779,
      "sourceHubAxis": [0, 1, 0],
      "notes": "Left-slant wheel. Its CAD hub axis is local +Y, so it requires an X rotation to stand upright."
    },
    "goBildaRightMecanum104": {

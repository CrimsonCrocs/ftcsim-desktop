{
  "name": "ftcsim-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "services/java-runner",
    "tools/gradle",
    "tools/cad-convert"
  ],
  "scripts": {
    "assets:prepare": "bun scripts/prepare-monaco-assets.ts && bun scripts/prepare-cad-assets.ts",
    "toolchains:install": "bun run --cwd services/java-runner toolchains:install",
    "build": "bun desktop/scripts/build.ts",
    "install:app": "bun desktop/scripts/install.ts",
    "start": "open \"desktop/build/FTC Simulator Desktop.app\"",
    "typecheck": "bun run --cwd desktop typecheck",
    "test": "bun run --cwd desktop test",
    "test:app": "bun desktop/scripts/verify-mcp.ts",
    "evaluate": "bun desktop/scripts/evaluate.ts",
    "mcp:call": "bun desktop/scripts/mcp-call.ts"
  },
  "dependencies": {
    "@ftc-studio/opmode-protocol": "workspace:*",
    "@ftc-studio/sim-core": "workspace:*",
    "@isomorphic-git/lightning-fs": "4.6.2",
    "@monaco-editor/react": "4.7.0",
    "@noble/hashes": "2.2.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.8.0",
    "@react-three/rapier": "2.0.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/sandbox": "3.3.0",
    "@xyflow/react": "12.11.2",
    "better-auth": "1.6.25",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "isomorphic-git": "1.38.6",
    "lucide-react": "1.24.0",
    "meshoptimizer": "0.22.0",
    "monaco-editor": "0.55.1",
    "next": "16.2.10",
    "onnxruntime-web": "1.30.0",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@gltf-transform/core": "4.4.1",
    "@gltf-transform/extensions": "4.4.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.182.0",
    "@vitest/coverage-v8": "3.2.7",
    "auth": "1.6.25",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "description": "Local FTC autonomous development with a warm JVM, deterministic physics replay, and MCP",
  "type": "module"
}
